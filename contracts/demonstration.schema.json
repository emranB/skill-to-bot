{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Raw drawing demonstration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "type",
    "coordinate_space",
    "canvas",
    "device",
    "source",
    "strokes"
  ],
  "properties": {
    "version": { "const": "1.0" },
    "type": { "const": "drawing" },
    "coordinate_space": { "const": "normalized_screen" },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspect_ratio"],
      "properties": {
        "aspect_ratio": { "type": "number", "minimum": 0.2, "maximum": 5 }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointer_type", "pressure_observed"],
      "properties": {
        "pointer_type": {
          "enum": ["pen", "touch", "mouse", "mixed"]
        },
        "pressure_observed": { "type": "boolean" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["human_capture", "synthetic_fixture"]
        }
      }
    },
    "strokes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["points"],
        "properties": {
          "color": { "type": "string", "pattern": "^#[a-fA-F0-9]{6}$" },
          "brush_size": { "type": "number", "minimum": 0.002, "maximum": 0.05 },
          "points": {
            "type": "array",
            "minItems": 2,
            "maxItems": 10000,
            "items": { "$ref": "#/$defs/point" }
          }
        }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "t_ms", "pointer_type"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "t_ms": { "type": "number", "minimum": 0, "maximum": 300000 },
        "pressure": { "type": "number", "minimum": 0, "maximum": 1 },
        "pointer_type": { "enum": ["pen", "touch", "mouse"] },
        "tilt_x": { "type": "number", "minimum": -90, "maximum": 90 },
        "tilt_y": { "type": "number", "minimum": -90, "maximum": 90 },
        "twist": { "type": "number", "minimum": 0, "maximum": 359 }
      }
    }
  }
}
