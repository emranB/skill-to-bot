{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Embodiment-independent DRAW skill",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "primitive",
    "frame",
    "aspect_ratio",
    "source",
    "strokes"
  ],
  "properties": {
    "version": { "const": "2.0" },
    "primitive": { "const": "draw" },
    "frame": { "const": "paper_normalized" },
    "aspect_ratio": { "type": "number", "minimum": 0.2, "maximum": 5 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "demonstration_id",
        "type",
        "pointer_type",
        "pressure_observed"
      ],
      "properties": {
        "demonstration_id": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "type": {
          "enum": ["human_capture", "synthetic_fixture"]
        },
        "pointer_type": {
          "enum": ["pen", "touch", "mouse", "mixed"]
        },
        "pressure_observed": { "type": "boolean" }
      }
    },
    "strokes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["points"],
        "properties": {
          "color": { "type": "string", "pattern": "^#[a-fA-F0-9]{6}$" },
          "brush_size": { "type": "number", "minimum": 0.002, "maximum": 0.05 },
          "points": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y", "t"],
              "properties": {
                "x": { "type": "number", "minimum": 0, "maximum": 1 },
                "y": { "type": "number", "minimum": 0, "maximum": 1 },
                "t": { "type": "number", "minimum": 0, "maximum": 300 },
                "pressure": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        }
      }
    }
  }
}
