# Purpose: Keep executable scripts and source files portable between Windows and Linux.
* text=auto
.gitattributes text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.md text eol=lf whitespace=-blank-at-eol
*.mp4 binary
